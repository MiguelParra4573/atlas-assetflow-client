root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
# Ancho de linea que Prettier respeta leyendolo desde 3.x. No se repite en
# .prettierrc.json: seria una segunda fuente de verdad que diverge.
max_line_length = 100
